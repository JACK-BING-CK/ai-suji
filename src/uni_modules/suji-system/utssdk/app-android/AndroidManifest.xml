<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- 系统分享面板直接把文字或 URL 交给这个窗口，无需读取其他应用的存储。 -->
        <activity android:name="app.suji.systementry.ShareActivity"
            android:label="AI速记" android:exported="true"
            android:excludeFromRecents="true" android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
        </activity>
        <activity android:name="app.suji.systementry.WidgetEntryActivity"
            android:exported="false" android:excludeFromRecents="true" android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <receiver android:name="app.suji.systementry.TodayWidget" android:exported="false"
            android:label="@string/suji_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/suji_today_widget" />
        </receiver>
    </application>
</manifest>
