        "selectedIconPath": "@ideasSelected"
      },
      {
        "pagePath": "pages/schedule/index",
        "text": "日程",
        "iconPath": "@schedule",
        "selectedIconPath": "@scheduleSelected"
      },
      {
        "pagePath": "pages/mine/index",
        "text": "我的",
        "iconPath": "@mine",
        "selectedIconPath": "@mineSelected"
      }
    ]
