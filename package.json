{
  "name": "ai-suji",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev:app": "uni -p app",
    "dev:h5": "uni",
    "dev:server": "npm run dev --workspace @ai-suji/server",
    "build:app": "uni build -p app",
    "build:h5": "uni build",
    "build:server": "npm run build --workspace @ai-suji/server",
    "test:sqlite": "node --import tsx --test tests/sqlite.test.mjs tests/sync-storage.test.mjs",
    "test:auth": "node --import tsx --test tests/auth-http.test.mjs server/tests/auth.test.mjs",
    "test:sync": "node --import tsx --test server/tests/sync.test.mjs tests/sync-storage.test.mjs tests/sync-service.test.mjs",
    "test:asr": "node --import tsx --test tests/voice-recorder.test.mjs server/tests/asr.test.mjs",
    "test:research": "node --import tsx --test tests/materials.test.mjs server/tests/research*.test.mjs",
    "test:expand": "node --import tsx --test server/tests/expand-model.test.mjs server/tests/expand.test.mjs",
    "test:workflow": "node --import tsx --test server/tests/breakdown.test.mjs tests/workflow.test.mjs",
    "test:calendar": "node --import tsx --test tests/calendar.test.mjs tests/schedules.test.mjs",
    "test:reminders": "node --import tsx --test tests/reminders.test.mjs",
    "type-check": "vue-tsc --noEmit && npm run typecheck --workspace @ai-suji/server",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,vue,json,css,scss,html}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,vue,json,css,scss,html}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030420261029002",
    "@dcloudio/uni-app-plus": "3.0.0-5030420261029002",
    "@dcloudio/uni-components": "3.0.0-5030420261029002",
    "@dcloudio/uni-h5": "3.0.0-5030420261029002",
    "pinia": "2.1.7",
    "vue": "3.4.21",
    "vue-i18n": "^9.14.5"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5030420261029002",
    "@dcloudio/uni-stacktracey": "3.0.0-5030420261029002",
    "@dcloudio/uni-uts-v1": "3.0.0-5030420261029002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030420261029002",
    "@eslint/js": "^10.0.1",
    "@vue/runtime-core": "3.4.21",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.6.2",
    "sass": "1.83.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "5.2.8",
    "vue-tsc": "~2.2.12"
  }
}
